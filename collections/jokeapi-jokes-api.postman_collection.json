      "item": [
        {
          "id": "4a8a391b-96f4-437f-81c9-aaead57b16c1",
          "name": "JokeAPI Get Joke by Category",
          "request": {
            "name": "JokeAPI Get Joke by Category",
            "description": {
              "content": "Retrieve one or more jokes from a single category, a comma-separated list of categories, or the special value `Any`. Supports filtering by blacklist flags, joke type, language, ID range, contains-text search, amount, and safe-mode.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "joke",
                ":category"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Defaults to `json`."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "ISO 639-1 language code for the joke language. Supported jokes languages include `en`, `de`, `cs`, `es`, `fr`, `pt`. Defaults to `en`."
                },
                {
                  "disabled": false,
                  "key": "blacklistFlags",
                  "value": "<string>",
                  "description": "Comma-separated list of flags to exclude (`nsfw`, `religious`, `political`, `racist`, `sexist`, `explicit`). Any joke carrying at least one listed flag is filtered out."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Restrict results to a single joke type."
                },
                {
                  "disabled": false,
                  "key": "contains",
                  "value": "<string>",
                  "description": "URL-encoded substring that must appear in the joke text (or the setup/delivery of a twopart joke)."
                },
                {
                  "disabled": false,
                  "key": "idRange",
                  "value": "<string>",
                  "description": "Inclusive ID range (e.g. `0-50`) or a single ID (e.g. `42`) to constrain results."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "1",
                  "description": "Number of jokes to retrieve (1-10). Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "safe-mode",
                  "value": "<string>",
                  "description": "When present (no value required), exclude any joke that carries any flag and any joke categorised as Dark."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "category",
                  "description": "(Required) Category or comma-separated list of categories. Use `Any` to draw from all categories."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
